# NutriGuide Flutter build configuration TEMPLATE — NAMES only, no real keys.
# Passed at build time via --dart-define (see docs/SETUP.md and CI workflow).
#
# NOTE: Firebase web API keys are PUBLIC client identifiers, not secrets; they
# are protected by Firebase security rules and App Check. Server secrets (AI
# provider keys, service accounts) live ONLY in the backend secret manager and
# never appear in the app.

APP_ENV=dev                      # dev | staging | prod
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
BACKEND_BASE_URL=                # e.g. https://us-central1-<project>.cloudfunctions.net
USE_DEV_STUB=true                # MUST be false for staging/prod builds
