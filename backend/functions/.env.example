# NutriGuide backend configuration TEMPLATE — variable NAMES only.
# Never commit real values. Secrets are stored in Google Secret Manager
# (firebase functions:secrets:set), non-secret params via .env or Remote Config.

# --- Secrets (set via: firebase functions:secrets:set DEEPSEEK_API_KEY) ---
# The production AI Coach uses DeepSeek (OpenAI-compatible API).
DEEPSEEK_API_KEY=

# --- Non-secret parameters (may live in functions/.env) ---
# AI model version. Change ONLY after passing ai_evals/ (see docs/SETUP.md).
# DeepSeek models: deepseek-chat (V3) or deepseek-reasoner (R1).
MODEL_ID=deepseek-chat
# DeepSeek API base URL (OpenAI-compatible). "/v1" is also accepted.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Server-side per-user daily AI request cap (fair use).
DAILY_AI_LIMIT=150

# --- Optional alternate provider (adapter kept at src/ai/anthropicProvider.ts) ---
# To use Claude instead, set this secret and swap the provider in index.ts.
# ANTHROPIC_API_KEY=
