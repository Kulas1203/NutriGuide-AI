# NutriGuide backend configuration TEMPLATE — variable NAMES only.
# Never commit real values. Secrets are stored in Google Secret Manager
# (firebase functions:secrets:set), non-secret params via .env or Remote Config.

# --- Secrets (set via: firebase functions:secrets:set ANTHROPIC_API_KEY) ---
ANTHROPIC_API_KEY=

# --- Non-secret parameters (may live in functions/.env) ---
# AI model version. Change ONLY after passing ai_evals/ (see docs/SETUP.md).
MODEL_ID=claude-sonnet-5
# Server-side per-user daily AI request cap (fair use).
DAILY_AI_LIMIT=150
