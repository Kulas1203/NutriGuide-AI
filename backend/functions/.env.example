# NutriGuide backend configuration TEMPLATE — variable NAMES only.
# Never commit real values. Secrets are stored in Google Secret Manager
# (firebase functions:secrets:set), non-secret params via .env or Remote Config.

# --- Secrets (set via: firebase functions:secrets:set AI_API_KEY) ---
# The AI Coach uses any OpenAI-compatible endpoint. Default: Groq (free tier).
# Get a key at https://console.groq.com/keys
AI_API_KEY=

# --- Non-secret parameters (may live in functions/.env) ---
# AI model version. Change ONLY after passing ai_evals/ (see docs/SETUP.md).
# Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant, etc.
MODEL_ID=llama-3.3-70b-versatile
# OpenAI-compatible API base URL for the chosen provider.
#   Groq:     https://api.groq.com/openai/v1
#   DeepSeek: https://api.deepseek.com
#   OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=https://api.groq.com/openai/v1
# Label used in audit/error logs to identify the provider.
AI_PROVIDER_NAME=groq
# Server-side per-user daily AI request cap (fair use).
DAILY_AI_LIMIT=150

# App Check enforcement. 'true' (default) is fail-closed. Set 'false' ONLY on a
# dev project exercised from a client without the native App Check SDK.
APP_CHECK_ENFORCED=true

# --- Optional alternate provider (adapter kept at src/ai/anthropicProvider.ts) ---
# To use Claude instead, set this secret and swap the provider in index.ts.
# ANTHROPIC_API_KEY=
