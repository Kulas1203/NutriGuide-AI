rules_version = '2';

// Firebase Storage rules. NutriGuide uses Storage only for optional user
// photo attachments (food photos). Each user can access only their own
// folder, files are size- and content-type-limited, and nothing is public.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/photos/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
